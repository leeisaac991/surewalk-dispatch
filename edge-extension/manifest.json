{
  "manifest_version": 3,
  "name": "SURE Walk Dispatch",
  "version": "1.0.0",
  "description": "Dispatch SURE Walk rides from the Excel rides workbook: assign crews, at, picked, cancel \u2014 with GroupMe ride posts.",
  "key": "",
  "action": {
    "default_title": "SURE Walk Dispatch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "identity",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://api.groupme.com/*"
  ]
}